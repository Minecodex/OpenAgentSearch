# Inject these variables through the shell, IDE, or container environment.
# Supply separate master and worker keys; administrator defaults can be overridden.
DATABASE_URL=postgres://oas:replace-with-your-password@127.0.0.1:5432/oas
OAS_MASTER_KEY=
OAS_WORKER_KEY=
OAS_ADMIN_USERNAME=admin
OAS_ADMIN_PASSWORD=admin123
OAS_PUBLIC_ORIGIN=http://localhost:5173
OAS_BIND=127.0.0.1:8080
OAS_RETENTION_DAYS=7
OAS_TRACE_QUEUE=8
OAS_HISTORY_GC_SECONDS=5
OAS_PROXY_FAILURE_THRESHOLD=3
OAS_PROXY_COOLDOWN_SECONDS=30
OAS_DEFAULT_NETWORK_VERSION=1
OAS_PROXY_TEST_URL=https://example.com/
OAS_PROXY_TEST_EXPECTED_STATUS=200
# OAS_PROXY_TEST_EXPECTED_BODY=expected marker
# Optional standalone Firefox worker registration for local development:
# OAS_WORKERS=[{"uid":"local-worker","name":"worker-a","address":"http://127.0.0.1:8090","slots":4}]

# Plan 2: optional system cache dependencies; each project must also enable its UI switch.
OAS_CACHE_HANDLER=v1
# Select v2 and pin the profile printed by the matcher training tool.
OAS_CACHE_MATCHER_URL=
OAS_CACHE_MATCHER_PROFILE=
OAS_CACHE_MATCHER_API_KEY=
OAS_CACHE_EMBEDDING_BASE_URL=
OAS_CACHE_EMBEDDING_API_KEY=
OAS_CACHE_EMBEDDING_MODEL=
OAS_CACHE_EMBEDDING_DIMENSIONS=768
OAS_CACHE_EMBEDDING_VERSION=1
OAS_CACHE_MATCH_THRESHOLD=0.92
OAS_CACHE_QDRANT_URL=
OAS_CACHE_QDRANT_API_KEY=
OAS_CACHE_QDRANT_SHARDS=1
OAS_CACHE_QDRANT_REPLICATION_FACTOR=1
OAS_CACHE_VALKEY_URL=
OAS_CACHE_VALKEY_PASSWORD=
# OAS_CACHE_VALKEY_CLUSTER_NODES=redis://node-a:6379,redis://node-b:6379
OAS_CACHE_S3_ENDPOINT=
OAS_CACHE_S3_REGION=us-east-1
OAS_CACHE_S3_BUCKET=
OAS_CACHE_S3_ACCESS_KEY=
OAS_CACHE_S3_SECRET_KEY=
OAS_CACHE_LOOKUP_TIMEOUT_MS=2000
OAS_CACHE_LIST_TTL_SECS=1800
OAS_CACHE_CONTENT_TTL_SECS=21600
OAS_CACHE_SUMMARY_MAX_INPUT_TOKENS=8192
OAS_CACHE_QUEUE_CAPACITY=1024
OAS_CACHE_TASK_TTL_SECS=1800
OAS_CACHE_TASK_MAX_ATTEMPTS=3
OAS_CACHE_MAX_OBJECT_BYTES=10737418240
OAS_CACHE_MAX_SNAPSHOTS=1000000
